{
  "name": "axial-video",
  "version": "1.0.0",
  "description": "Axial gameplay overview video: frame-exact recordings of the real game, edited in Remotion",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/fonts": "4.0.526",
    "@remotion/media": "4.0.526",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.526",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.7.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open --port=3333",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "check": "tsc --noEmit",
    "render:overview": "remotion render src/index.ts Overview out/axial-overview-1080p60.mp4 --codec=h264 --crf=16"
  },
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
