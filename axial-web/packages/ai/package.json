{
  "name": "@axial/ai",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./presets": "./src/classic/presets.ts"
  },
  "scripts": {
    "eval:rules": "AXIAL_AI_RULE_EVAL=1 vitest run src/rules.eval.test.ts --reporter=verbose",
    "eval:rules:full": "AXIAL_AI_FULL_RULE_EVAL=1 vitest run src/rules.eval.test.ts --reporter=verbose",
    "eval:variants": "AXIAL_AI_VARIANT_EVAL=1 vitest run src/rules.eval.test.ts --reporter=verbose",
    "eval:strength": "AXIAL_AI_STRENGTH_EVAL=1 vitest run src/strength.eval.test.ts --reporter=verbose",
    "eval:strength:hard": "AXIAL_AI_STRENGTH_EVAL=1 AXIAL_AI_STRENGTH_OPPONENT=hard vitest run src/strength.eval.test.ts --reporter=verbose",
    "eval:ladder": "AXIAL_AI_LADDER_EVAL=1 vitest run src/ladder.eval.test.ts --reporter=verbose",
    "eval:parity": "AXIAL_AI_PARITY_EVAL=1 vitest run src/parity.eval.test.ts --reporter=verbose",
    "eval:challenges": "AXIAL_AI_CHALLENGE_EVAL=1 vitest run src/challenges.eval.test.ts --reporter=verbose",
    "eval:challenge:full": "AXIAL_AI_CHALLENGE_EVAL=1 AXIAL_AI_CHALLENGE_FULL=1 vitest run src/challenges.eval.test.ts --reporter=verbose",
    "eval:challenges:baseline": "AXIAL_AI_BASELINE_CHALLENGE_EVAL=1 AXIAL_AI_BASELINE_BUNDLE=/tmp/axial-classic-ai-baseline.mjs vitest run src/baselineChallenges.eval.test.ts --reporter=verbose",
    "eval:forensics": "AXIAL_AI_FORENSICS=1 vitest run src/forensics.eval.test.ts --reporter=verbose",
    "eval:profile": "AXIAL_AI_PROFILE=1 vitest run src/profile.eval.test.ts --reporter=verbose",
    "eval:paired": "AXIAL_AI_PAIRED_EVAL=1 AXIAL_AI_BASELINE_BUNDLE=/tmp/axial-classic-ai-baseline.mjs vitest run src/paired.eval.test.ts --reporter=verbose",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@axial/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.3"
  }
}
